<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hr.tvz.projekt.controller.VolunteersController"
      style="-fx-padding: 12;">

    <Label text="Pretraživanje volontera"
           style="-fx-font-size: 16px; -fx-font-weight: bold;" />

    <HBox spacing="10">
        <Label text="Pretraži po:" />
        <ComboBox fx:id="fieldCombo" prefWidth="200"/>

        <Label text="Vrijednost:" />
        <TextField fx:id="valueField" prefWidth="250"/>

        <Button text="Pretraži" onAction="#onSearch"/>
        <Button text="Reset" onAction="#onReset"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colName" text="Ime i prezime" prefWidth="200"/>
            <TableColumn fx:id="colCity" text="Grad" prefWidth="140"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="220"/>
            <TableColumn fx:id="colAge" text="Dob" prefWidth="70"/>
            <TableColumn fx:id="colSkillType" text="Vještina" prefWidth="160"/>
        </columns>
    </TableView>

</VBox>
