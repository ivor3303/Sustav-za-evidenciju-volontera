<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="hr.tvz.projekt.controller.EventsController">

    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="Pretraživanje događaja" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Pretraži po:"/>
                <ComboBox fx:id="fieldCombo" prefWidth="200"/>

                <Label text="Vrijednost:"/>
                <TextField fx:id="valueField" prefWidth="300"/>

                <Button text="Pretraži" onAction="#onSearch"/>
                <Button text="Reset" onAction="#onReset"/>
            </HBox>
        </VBox>
    </top>


    <center>
        <TableView fx:id="table">
            <columns>
                <TableColumn fx:id="colTitle" text="Naziv" prefWidth="220"/>
                <TableColumn fx:id="colCity" text="Grad" prefWidth="150"/>
                <TableColumn fx:id="colAddress" text="Adresa" prefWidth="220"/>
                <TableColumn fx:id="colType" text="Tip" prefWidth="150"/>
            </columns>
        </TableView>
    </center>

</BorderPane>
